sparkxy = -5, -80		;X-offset for the "hit spark" rel. to p2,					;Y-offset for the spark rel. to p1
guard.sparkno = S10008
hitsound = S200,10			;Sound to play on hit
guardsound = 6, 0			;Sound to play on guard
