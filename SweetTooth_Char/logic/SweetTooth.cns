;|____________________ by Varia31 (variathehunter@yahoo.com) _________________________|
;                     \_____________________________________/
[Data]
life = 1000			;Amount of life to start with
power = 3000		;Amount of maximum power
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 50		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = S10008	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volumescale = 999			;Volume offset (negative for softer)
IntPersistIndex = 60	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 0.25			;Horizontal scaling factor.
yscale = 0.25			;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 70			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = 5, -115	;Approximate position of head
mid.pos = 5, -70		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4		;Walk forward
walk.back = -2		;Walk backward
run.fwd  = 10		;Run forward (x, y)
run.back = -8,0	;Hop backward (x, y)
jump.neu = 0,-10.3		;Neutral jumping velocity (x, y)
jump.back = -3.45		;Jump back Speed (x, y)
jump.fwd = 4.3		;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1;Running jump speeds (opt)
runjump.fwd = 4,-8.1	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .48		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
[Quotes]
victory1 = "You picked the wrong clown to cross today..."
victory2 = "Boys and girls, that was so much fun!"
victory3 = "First you, then Calypso, and now... everyone else!"
victory4 = "That was a good warm-up..."
victory5 = "I'm gonna make you regret not killing me when you had the chance..."
victory6 = "That was amusing... Ahh, but all those people I haven't killed yet! Looks like I have work to do."
victory7 = "I'll be the greatest killer the world has ever known. You'll see. Everyone will fear the name of Sweet Tooth!"
victory8 = "You can't kill me. You can never kill me!" 
victory9 = "Stupid clown. If you still breathe, go back to running your fast food joint." 
victory10 = "You can't possibly win! Now go make me one of your McFlurries before I cut you here and now."
victory11 = "Leave the fighting to us big dogs, you pathetic excuse of a clown!"
victory12 = "To think that you were perhaps my biggest competition. Don't make me laugh..."
victory13 = "News flash. Your jokes... aren't funny."
victory14 = "There's only room for one clown in this town!"
victory15 = "Don't worry about Gotham. I'll take care of it for you."
victory16 = "If you can't handle the Bat... I will."
victory17 = "So you're the famous Dark Knight? Not impressed."
victory18 = "Now that you're out of the way, I think I'll take a stroll around Gotham... 'see what I can carve my knife into."
victory19 = "Stupid. Little. Bat."
victory20 = "You thought your Joker friend was bad? You ain't seen anything yet."
victory21 = "'World's greatest detective'... Didn't really think this one through, did you?"
victory22 = "Some god you turned out to be... You just got screwed over by a mortal."
victory23 = "God of War? More like God of Bore!"
victory24 = "You should have stayed in Sparta."
victory25 = "The 'Ghost of Sparta'? I guess you're REALLY a ghost now!"
victory26 = "I've killed tougher than you. Try dealing with Calypso. See how that goes for ya..."

;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
movetype = I
physics = S
anim = 3

[State 0, DestroySelf]
type = DestroySelf
trigger1 = IsHelper

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = anim != 0
triggerall = anim = 5
trigger1 = animtime = 0
value = 0

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = PalNo = 5
trigger1 = time = 0
value = 7

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = PalNo = 6
trigger1 = time = 0
value = 8

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = Life <= 150
trigger1 = time = 0
value = 65

[State 0, ChangeState]
type = ChangeState
trigger1 = time = 700
value = 1

[State 0, ChangeState]
type = ChangeState
triggerall = power >= 3000
trigger1 = time = 0
value = 5

