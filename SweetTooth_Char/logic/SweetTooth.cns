;---------------------------------------------------------------------------
;Power Charge (Thanks, chuchoryu, I was wondering how this worked.)
[Statedef 9000]
type = S
movetype = I
Physics = S
velset = 0,0
ctrl = 0
anim = 9000

[State 9002, PlaySnd]
type = PlaySnd
trigger1 = time = 0
persistent = 0
volumescale = 900
value = 9010, 3+(random%2)
channel = 0

[State 9000, "Head flame"]
type = Helper
trigger1 = animelem = 3
StateNo = 9002
HelperType = normal
pos = 10,-116
postype = p1
id = 9000
ignorehitpause = 1
sprpriority = 2
ownpal = 0
size.xscale = 0.6
size.yscale = 0.6

[State 9000, PowerAdd]
type = PowerAdd
triggerAll = Power < const(data.power) && Power < PowerMax
trigger1 = (command = "hold_b" && command = "hold_y")
value = 5 + ifElse(time < 60, 0, (time - 60) / 12)

[State 730, Character Flash]
type = PalFX
trigger1 = 1
time = 1
add = 75 + ceil(sin(Time / 6.0 * pi) * 75),25 + ceil(sin(Time / 6.0 * pi) * 25),0

[State 9000, End]
type = ChangeState
trigger1 = Power >= const(data.power) || Power >= PowerMax || RoundState != 2
trigger2 = (command != "hold_b" || command != "hold_y")
value = 9001
ctrl = 1

